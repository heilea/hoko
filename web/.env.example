# Modèle : copier ce fichier en .env.local, puis remplir les valeurs.
# .env.local n'est jamais commité.

# Supabase : Project Settings > API dans le tableau de bord du projet
NEXT_PUBLIC_SUPABASE_URL=
# Clé publique (« publishable », ou l'ancienne clé « anon »)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé secrète (« secret », sb_secret_…), au même endroit que la clé publique.
# Sert seulement au serveur, pour déposer et effacer les photos : un compte ne peut pas
# écrire lui-même dans le stockage. Jamais de préfixe NEXT_PUBLIC_, jamais commitée.
SUPABASE_SECRET_KEY=

# Adresse publique du site, pour les liens envoyés par e-mail.
# Facultative en local (http://localhost:3000), obligatoire en production.
# Sur Vercel : l'adresse fixe du projet, avec https:// et sans / final (voir README.md).
SITE_URL=
